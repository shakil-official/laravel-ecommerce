APP_NAME="Bangla Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:6180
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (inside the docker network the host name is the service name) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_ecommerce
DB_USERNAME=shop
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Shop -------------------------------------------------------------------
SHOP_CURRENCY="৳"
SHOP_ADMIN_PER_PAGE=10
SHOP_LISTING_PER_PAGE=4

# --- Admin login (created by `php artisan db:seed`) -----------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
